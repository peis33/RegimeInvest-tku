# Copy this file to .env and insert your own TEJ API key.
# NEVER commit the real .env file.

# 正式預設使用本地 CSV：2014-2025 歷史資料 + 手動維護的 2026 資料。
MODEL1_DATA_SOURCE=csv
HISTORY_CSV_PATH=加權指數2014-2025.csv
MODEL1_2026_CSV=加權指數2026.csv

# 如日後要測試 TEJ + CSV 的混合來源，再改成 hybrid，並補上 API Key。
# MODEL1_DATA_SOURCE=hybrid
TEJ_API_KEY=YOUR_TEJ_API_KEY_HERE
